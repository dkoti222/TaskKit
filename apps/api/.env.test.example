# Used by `npm run test:e2e` and `npm run test:db:reset`. Copy to .env.test (git-ignored).
# A separate database: e2e tests empty it before every test file.
DATABASE_URL="postgresql://USER@localhost:5432/taskkit_test"
JWT_ACCESS_SECRET="test-access-secret"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
RESET_PASSWORD_URL="taskkit://reset-password"
# The notifications queue needs Redis; e2e tests don't cover it, so it's off here.
NOTIFICATIONS_ENABLED="false"
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads-test"
