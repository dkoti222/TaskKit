{
  "info": {
    "name": "TaskKit · Step 9 realtime",
    "description": "HTTP requests that send realtime events. Open a Socket.IO request in Postman to {{socketUrl}} with auth {\"token\": \"<john_token>\"}, listen to board:event and board:access-removed, then send board:join {\"boardId\": \"{{boardId}}\"} with \"Acknowledgement\" on. See docs/learning/step-09-realtime.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "socketUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "boardId",
      "value": "e9cd73a3-7e3e-4388-94e0-21a2356f4ffe"
    },
    {
      "key": "privateBoardId",
      "value": "06509663-757b-43b0-bfbc-667a4b494050"
    },
    {
      "key": "cardId",
      "value": ""
    },
    {
      "key": "cardVersion",
      "value": ""
    },
    {
      "key": "listId",
      "value": ""
    },
    {
      "key": "ravi_token",
      "value": ""
    },
    {
      "key": "john_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Log in",
      "item": [
        {
          "name": "Log in as Ravi (Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('ravi_token', j.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ravi@taskkit.test\",\n  \"password\": \"Test1234\"\n}"
            }
          }
        },
        {
          "name": "Log in as John (Viewer on Website)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('john_token', j.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@taskkit.test\",\n  \"password\": \"Test1234\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "1 · Board content (pick a card)",
      "item": [
        {
          "name": "Board content",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json().lists[0].cards[0];",
                  "pm.collectionVariables.set('cardId', c.id);",
                  "pm.collectionVariables.set('cardVersion', c.version);",
                  "pm.collectionVariables.set('listId', pm.response.json().lists[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "content"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 · Changes that send board:event",
      "item": [
        {
          "name": "Move card to the bottom of its list → card.moved",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cardVersion', pm.response.json().version);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/move",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "move"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listId\": \"{{listId}}\",\n  \"index\": 99,\n  \"version\": \"{{cardVersion}}\"\n}"
            }
          }
        },
        {
          "name": "Edit card title → card.updated",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Edited from Postman\"\n}"
            }
          }
        },
        {
          "name": "Rename list → list.updated",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lists/{{listId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lists",
                "{{listId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"To do\"\n}"
            }
          }
        },
        {
          "name": "Add checklist item → checklist.changed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/checklist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "checklist"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"From Postman\"\n}"
            }
          }
        },
        {
          "name": "Viewer edits card → 403, no event",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3 · Access removed",
      "item": [
        {
          "name": "Make private board a WORKSPACE board",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{privateBoardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{privateBoardId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visibility\": \"WORKSPACE\"\n}"
            }
          }
        },
        {
          "name": "Make it PRIVATE again → board:access-removed for John",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{privateBoardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{privateBoardId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visibility\": \"PRIVATE\"\n}"
            }
          }
        }
      ]
    }
  ]
}
