DATABASE_URL="postgresql://USER@localhost:5432/taskkit"
PORT=3000
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
RESET_PASSWORD_URL="taskkit://reset-password"
# Step 11 · Notifications. Redis for the BullMQ queue (Homebrew: brew services start redis).
REDIS_URL="redis://localhost:6379"
# "false" turns notifications off entirely (no Redis needed). Default: on.
NOTIFICATIONS_ENABLED="true"
# Optional: only if "enhanced push security" is on for the Expo project (expo.dev → Access tokens).
EXPO_ACCESS_TOKEN=""

# Step 12 · Attachments. "local" (default) keeps files in apps/api/uploads; "s3" uses a bucket.
STORAGE_DRIVER="local"
# Optional: folder for local files, and a separate secret for signed file links (defaults to JWT_ACCESS_SECRET).
UPLOADS_DIR=""
STORAGE_SIGNING_SECRET=""
# Only for STORAGE_DRIVER="s3". Cloudflare R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto".
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
