            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya@taskkit.test\",\n  \"password\": \"Test1234\"\n}"
            }
          }
        },
        {
          "name": "Board content → pick a card (see commentCount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cardId', pm.response.json().lists[0].cards[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "content"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1 · Comments",
      "item": [
        {
          "name": "Sana comments, mentioning Ravi → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('commentId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sana_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"@[{{raviId}}] should expiry be 7 days or 48 hours?\"\n}"
            }
          }
        },
        {
          "name": "John (Viewer) comments → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Hello\"\n}"
            }
          }
        },
        {
          "name": "Blank comment → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sana_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"   \"\n}"
            }
          }
        },
        {
          "name": "List comments (John can read) → 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/comments?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "comments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Ravi edits Sana's comment → 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "{{commentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Changed\"\n}"
            }
          }
        },
        {
          "name": "Sana edits her comment → 200, editedAt set",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sana_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "{{commentId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"@[{{raviId}}] 7 days, I think.\"\n}"
            }
          }
        },
        {
          "name": "Priya (Member) deletes Sana's comment → 403",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{priya_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/comments/{{commentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "comments",
                "{{commentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 · Activity",
      "item": [
        {
          "name": "Card activity (comments and changes)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/activity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "activity"
              ]
            }
          }
        },
        {
          "name": "Board activity, 2 per page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('nextCursor', pm.response.json().nextCursor);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/activity?limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "activity"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Board activity, next page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/activity?limit=2&cursor={{nextCursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "activity"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                },
                {
                  "key": "cursor",
                  "value": "{{nextCursor}}"
                }
              ]
            }
          }
        },
        {
          "name": "Board activity, member changes only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/activity?kind=members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "activity"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "members"
                }
              ]
            }
          }
        },
        {
          "name": "limit=500 → 400",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/activity?limit=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "activity"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "500"
                }
              ]
            }
          }
        },
        {
          "name": "Outsider: John on a private board → 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{john_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{privateBoardId}}/activity",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{privateBoardId}}",
                "activity"
              ]
            }
          }
        }
      ]
    },
