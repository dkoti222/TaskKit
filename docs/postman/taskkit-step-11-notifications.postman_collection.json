{
  "info": {
    "name": "TaskKit · Step 11 notifications",
    "description": "Needs Redis running (brew services start redis). Notifications are written by a background worker: wait a second before listing them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "boardId",
      "value": "e9cd73a3-7e3e-4388-94e0-21a2356f4ffe"
    },
    {
      "key": "workspaceId",
      "value": "64769558-eedb-4ed5-af77-68045759bb75"
    },
    {
      "key": "cardId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "raviId",
      "value": ""
    },
    {
      "key": "sanaId",
      "value": ""
    },
    {
      "key": "ravi_token",
      "value": ""
    },
    {
      "key": "sana_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Log in",
      "item": [
        {
          "name": "Ravi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ravi_token', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('raviId', pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ravi@taskkit.test\",\n  \"password\": \"Test1234\"\n}"
            }
          }
        },
        {
          "name": "Sana",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sana_token', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('sanaId', pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sana@taskkit.test\",\n  \"password\": \"Test1234\"\n}"
            }
          }
        },
        {
          "name": "Pick a card",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cardId', pm.response.json().lists[0].cards[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "content"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1 · Make notifications for Ravi",
      "item": [
        {
          "name": "Sana assigns Ravi → card.assigned",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sana_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/assignees/{{raviId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "assignees",
                "{{raviId}}"
              ]
            }
          }
        },
        {
          "name": "Sana mentions Ravi → comment.mentioned",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sana_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "comments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"@[{{raviId}}] can you check this today?\"\n}"
            }
          }
        },
        {
          "name": "Ravi assigns himself → no notification",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/assignees/{{raviId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "assignees",
                "{{raviId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2 · Ravi reads them",
      "item": [
        {
          "name": "Unread count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/unread-count",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "unread-count"
              ]
            }
          }
        },
        {
          "name": "List (newest first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('notificationId', pm.response.json().items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Unread only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications?unread=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications"
              ],
              "query": [
                {
                  "key": "unread",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Sana marks Ravi's notification read → 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sana_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{notificationId}}",
                "read"
              ]
            }
          }
        },
        {
          "name": "Mark one read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "{{notificationId}}",
                "read"
              ]
            }
          }
        },
        {
          "name": "Mark all read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/read-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notifications",
                "read-all"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3 · Settings and push tokens",
      "item": [
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/notification-settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notification-settings"
              ]
            }
          }
        },
        {
          "name": "Turn off due reminders",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/notification-settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notification-settings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueReminders\": false\n}"
            }
          }
        },
        {
          "name": "Turn them back on",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/notification-settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notification-settings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueReminders\": true\n}"
            }
          }
        },
        {
          "name": "Bad value → 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/notification-settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "notification-settings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"push\": \"yes\"\n}"
            }
          }
        },
        {
          "name": "Save a push token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/push-tokens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "push-tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"ExponentPushToken[postman-test-token]\",\n  \"platform\": \"ios\"\n}"
            }
          }
        },
        {
          "name": "Delete it",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ravi_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me/push-tokens/ExponentPushToken%5Bpostman-test-token%5D",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "push-tokens",
                "ExponentPushToken%5Bpostman-test-token%5D"
              ]
            }
          }
        }
      ]
    }
  ]
}
